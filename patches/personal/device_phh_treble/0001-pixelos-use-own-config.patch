From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: farrizdesignpro1339
Date: Sat, 27 Sep 2026 00:00:00 +0700
Subject: [PATCH 1/3] pixelos: use own config (converted from lineage)

Converted from LineageOS_gsi 0002-lineage-use-own-config-and-targets.patch
- lineage.mk -> custom.mk (vendor/lineage -> vendor/custom)
- drop lineage-specific apicheck/BoardConfigLineage (PixelOS beda path)
- keep generic_arm64 device, bootanim, APN, udfps
- NOTE A17: jangan bikin lineage_arm64_bgN* legacy, lunch pake
  `lunch custom_arm64 trunk_staging userdebug` (format baru)

---
 AndroidProducts.mk |  9 +++++++++
 custom.mk          | 18 ++++++++++++++++++
 2 files changed, 27 insertions(+)
 create mode 100644 AndroidProducts.mk
 create mode 100644 custom.mk

diff --git a/AndroidProducts.mk b/AndroidProducts.mk
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/AndroidProducts.mk
@@ -0,0 +1,9 @@
+#
+# PixelOS GSI Serenity (converted from LineageOS_gsi)
+# SPDX-License-Identifier: Apache-2.0
+#
+
+PRODUCT_MAKEFILES += \
+    $(LOCAL_DIR)/custom_arm64.mk
diff --git a/custom.mk b/custom.mk
new file mode 100644
index 0000000..2222222
--- /dev/null
+++ b/custom.mk
@@ -0,0 +1,18 @@
+$(call inherit-product, vendor/custom/config/common_full_phone.mk)
+$(call inherit-product, device/custom/sepolicy/common/sepolicy.mk)
+
+PRODUCT_DEVICE := generic_arm64
+PRODUCT_MANUFACTURER := google
+
+# Bootanimation
+TARGET_BOOT_ANIMATION_RES := 1080
+
+# APN
+PRODUCT_PACKAGES += apns-conf.xml
+
+#Oplus fingerprint
+$(call soong_config_set,surfaceflinger,udfps_lib,//hardware/oplus:libudfps_extension.oplus)
--
2.54.0
